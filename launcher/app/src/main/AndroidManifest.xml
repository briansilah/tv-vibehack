<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Needed on Android 10 to read the Wi-Fi network name; granted over adb at install time. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Opens Google TV's quick settings panel from the top bar (StatusBarManager.expandNotificationsPanel). -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Top shelf art (config.xml, top_shelf_art): suggested titles' pictures and public catalogue feeds. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Top shelf art: reads what apps publish on the TV for the home screen (Watch Next, preview channels) from
         TvProvider. Granted over adb at install time; without it the top shelf uses feeds and cover art. -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <!-- Google TV's Home button service (VolumeHold): reads `dumpsys input` to tell whether a volume key is still
         held, so a held key keeps changing the volume. Granted over adb at install time. -->
    <uses-permission android:name="android.permission.DUMP" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.TvHome"
        android:allowBackup="false">

        <!-- Lets tools/perf.py and Android Studio CPU-profile and heap-profile release builds, as on
             a stock install. Ignored before Android 10; no runtime cost. -->
        <profileable android:shell="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Home Settings: the launcher's own settings. A TV app of its own, so it's a tile in the grid as tvOS's
             Settings app is on its Home Screen (AppAdapter shows it; hidden_apps can hide it), and the Top Shelf row of
             an app's actions opens it on that app. Never kept in the background: Home or another app ends it. -->
        <activity
            android:name=".SettingsActivity"
            android:label="@string/home_settings"
            android:icon="@drawable/ic_settings"
            android:banner="@drawable/settings_banner"
            android:exported="true"
            android:taskAffinity="com.gathin.tvhome.settings"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Screensaver: pick it in Settings, or `settings put secure screensaver_components
             com.gathin.tvhome/.ClockDream` over adb. -->
        <service
            android:name=".ClockDream"
            android:label="@string/dream_name"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Google TV: keeps Home on this launcher while the stock launcher stays enabled for its quick settings
             panel. build-and-install.sh turns it on there; tools/restore.sh turns it off. Own process: every key
             waits for it, so it must not share the launcher's UI thread. -->
        <service
            android:name=".HomeButtonService"
            android:label="@string/app_name"
            android:process=":home"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_button_service" />
        </service>
    </application>
</manifest>
