<?xml version="1.0" encoding="utf-8"?>
<!-- HomeButtonService: filters keys to take the remote's Home press (every other key is passed straight on) and watches
     which activity comes to the front (package and class). Window content is read once, when the service starts, and
     only for the package of the active window; no text is read. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="0"
    android:description="@string/home_button_description" />
