<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration. Edit this file, then run launcher/build-and-install.sh.
  Package names: on the TV run `pm list packages` (tools/tv.py 'pm list packages').
-->
<resources>

    <!-- Apps pinned to the dock row at the bottom, in this order. Missing apps are skipped. This is only
         the default: once you arrange apps on the TV (hold OK on an app and pick Move), your own
         order is kept instead. Clear the launcher's storage to go back to this one. -->
    <string-array name="dock_apps">
        <item>com.netflix.ninja</item>
        <item>com.amazon.amazonvideo.livingroom</item>
        <item>com.google.android.youtube.tv</item>
        <item>in.startv.hotstar</item>
    </string-array>

    <!-- Apps never shown as tiles (e.g. the Live TV app, which the Inputs menu already covers). -->
    <string-array name="hidden_apps">
        <item>com.mediatek.wwtv.tvcenter</item>
        <item>com.mitv.gallery</item>
    </string-array>

    <!-- The TV's Live TV / tuner app, offered at the end of the Inputs menu. Leave empty to omit. -->
    <string name="live_tv_package" translatable="false">com.mediatek.wwtv.tvcenter</string>

    <!-- Tiles per row in the grid; the dock always has this many slots. -->
    <integer name="columns">4</integer>

    <!-- Top right: the time and your profile picture, as on Apple TV. Moving up there opens it and shows the
         Inputs, Wi-Fi and Settings buttons, which look like this:
         tvos    icons, the focused one in a white circle, like the tabs of Apple TV's Control Center
         google  icons grouped in one tray; the focused one turns pale and its name shows underneath,
                 like the Google TV home screen
         apple   round icons; the focused one opens into a pill with its name
         pills   frosted pills, each with its icon and name -->
    <string name="top_bar_style" translatable="false">tvos</string>

    <!-- Liquid Glass, as on Apple TV, for the dock and the top right: how see-through it is, from 0 to 100, as
         Apple's Liquid Glass slider. 5 is Clear, Apple TV's own look; 95 is Tinted, darker and more frosted, for
         readability over busy pictures. You can also change it on the TV: hold OK on any app, then Liquid Glass.
         That choice is kept until you change it again, or clear the launcher's storage. -->
    <integer name="liquid_glass">5</integer>

    <!-- On Android 12 and later what's behind the glass shows through blurred and more colourful, and on Android 13
         and later it bends along its edges. It costs the GPU a small layer, redrawn only when the top shelf changes
         (docs/performance.md). Set to false on a TV that stutters: the glass keeps its tint and rim, without the
         blur. -->
    <bool name="liquid_glass_blur">true</bool>

    <!-- Your name, for the profile picture in the top right: its initials, as Apple TV shows for a profile
         without a photo. Leave empty for the plain silhouette. (Android doesn't let apps read the TV's
         Google account name or photo.) -->
    <string name="profile_name" translatable="false"></string>
</resources>
