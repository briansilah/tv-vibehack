<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration. Edit this file, then run launcher/build-and-install.sh.
  Package names: on the TV run `pm list packages` (tools/tv.py 'pm list packages').
-->
<resources>

    <!-- Apps pinned to the dock row at the bottom, in this order. Missing apps are skipped. This is only
         the default: once you arrange apps on the TV (hold OK on an app and pick Move), your own
         order is kept instead. Clear the launcher's storage to go back to this one. -->
    <string-array name="dock_apps">
        <item>com.netflix.ninja</item>
        <item>com.amazon.amazonvideo.livingroom</item>
        <item>com.google.android.youtube.tv</item>
        <item>in.startv.hotstar</item>
    </string-array>

    <!-- Apps never shown as tiles (e.g. the Live TV app, which the Inputs menu already covers). The launcher's own
         Home Settings is a tile too; com.gathin.tvhome here hides it. -->
    <string-array name="hidden_apps">
        <item>com.mediatek.wwtv.tvcenter</item>
        <item>com.mitv.gallery</item>
    </string-array>

    <!-- The TV's Live TV / tuner app, offered at the end of the Inputs menu. Leave empty to omit. -->
    <string name="live_tv_package" translatable="false">com.mediatek.wwtv.tvcenter</string>

    <!-- Tiles per row in the grid; the dock always has this many slots. -->
    <integer name="columns">4</integer>

    <!-- Top right: the time and your profile picture, as on Apple TV. Moving up there opens it and shows the
         Inputs, Wi-Fi and Settings buttons, which look like this:
         tvos    icons, the focused one in a white circle, like the tabs of Apple TV's Control Center
         google  icons grouped in one tray; the focused one turns pale and its name shows underneath,
                 like the Google TV home screen
         apple   round icons; the focused one opens into a pill with its name
         pills   frosted pills, each with its icon and name -->
    <string name="top_bar_style" translatable="false">tvos</string>

    <!-- Liquid Glass, as on Apple TV, for the dock and the top right: how see-through it is, from 0 to 100, as
         Apple's Liquid Glass slider. 0 is the clearest (the default); 5 is Clear, Apple TV's own look; 95 is Tinted,
         darker and more frosted, for readability over busy pictures. You can also change it on the TV: hold OK on any
         app, then Liquid Glass. That choice is kept until you change it again, or clear the launcher's storage. -->
    <integer name="liquid_glass">0</integer>

    <!-- On Android 12 and later what's behind the glass shows through blurred and more colourful, and on Android 13
         and later it bends along its edges. It costs the GPU a small layer, redrawn only when the top shelf changes
         (docs/performance.md). Set to false on a TV that stutters: the glass keeps its tint and rim, without the
         blur. -->
    <bool name="liquid_glass_blur">true</bool>

    <!-- Your name, for the profile picture in the top right: its initials, as Apple TV shows for a profile
         without a photo. Leave empty for the plain silhouette. (Android doesn't let apps read the TV's
         Google account name or photo.) -->
    <string name="profile_name" translatable="false"></string>

    <!-- Top shelf art: with focus on a dock app, the space above the dock shows, best first,
         1. what the app suggests: what it publishes on the TV for the home screen (what you were watching, its
            recommendations; needs READ_TV_LISTINGS, which build-and-install.sh grants), then the titles of its
            feed below; or, for an app in top_shelf_images, its static image instead;
         2. its artwork, for the apps that have one (ShelfArtworks.java): a picture painted for the app in its
            brand's colours and shapes, with its logo; else its cover art: its logo, cut out of its banner, on
            shapes in its colours;
         3. otherwise the ambient glow and its name.
         false: always the glow and name, with no network use.
         Home Settings on the TV changes this per app: suggestions, a static image, the glow alone, or the app's
         artwork, cover art or a colour. -->
    <bool name="top_shelf_art">true</bool>

    <!-- Apps whose top shelf is one static image, as tvOS shows YouTube's, instead of suggestions: "package [| URL]".
         This is the default; Home Settings on the TV can change it for any app.
         The image is the one you put on the TV with tools/top_shelf_image.py (from a screenshot of an Apple TV's
         home screen), else one fetched once from the https URL and kept on the TV. Until it has one, the app shows
         its artwork (or cover art). Up from the app moves to a button that opens it. -->
    <string-array name="top_shelf_images" translatable="false">
        <item>com.google.android.youtube.tv</item>
    </string-array>

    <!-- Public catalogues of suggested titles, per app: "package | caption | URL | URL ...", each URL a Stremio
         catalogue (JSON with "metas": id, name, background, logo). {country} in a URL becomes the TV's country (ke, us, ...):
         its time zone's, else its language and region setting's, else "global"; the caption then names it.
         Fetched at most every 6 hours, only when Home shows, and kept on the TV for offline use. Remove a line to
         keep an app to its own suggestions and cover art. -->
    <string-array name="top_shelf_feeds" translatable="false">
        <item>com.netflix.ninja | Top 10 on Netflix | https://7a82163c306e-stremio-netflix-catalog-addon.baby-beamup.club/catalog/series/netflix-top10-{country}.json | https://7a82163c306e-stremio-netflix-catalog-addon.baby-beamup.club/catalog/movie/netflix-top10-{country}.json</item>
        <item>com.apple.atve.androidtv.appletv | Popular on Apple TV+ | https://7a82163c306e-stremio-netflix-catalog-addon.baby-beamup.club/catalog/series/atp.json | https://7a82163c306e-stremio-netflix-catalog-addon.baby-beamup.club/catalog/movie/atp.json</item>
        <item>com.amazon.amazonvideo.livingroom | Popular on Prime Video | https://7a82163c306e-stremio-netflix-catalog-addon.baby-beamup.club/catalog/series/amp.json | https://7a82163c306e-stremio-netflix-catalog-addon.baby-beamup.club/catalog/movie/amp.json</item>
        <item>com.disney.disneyplus | Popular on Disney+ | https://7a82163c306e-stremio-netflix-catalog-addon.baby-beamup.club/catalog/series/dnp.json | https://7a82163c306e-stremio-netflix-catalog-addon.baby-beamup.club/catalog/movie/dnp.json</item>
        <item>in.startv.hotstar | Popular on JioHotstar | https://7a82163c306e-stremio-netflix-catalog-addon.baby-beamup.club/catalog/series/jhs.json | https://7a82163c306e-stremio-netflix-catalog-addon.baby-beamup.club/catalog/movie/jhs.json</item>
        <item>com.stremio.one | Popular on Stremio | https://cinemeta-catalogs.strem.io/top/catalog/movie/top.json | https://cinemeta-catalogs.strem.io/top/catalog/series/top.json</item>
    </string-array>

    <!-- The logo on artwork and cover art, sharp at any size: a vector logo from Simple Icons (simpleicons.org, CC0), fetched once
         and kept on the TV: "package | icon | brand colour (RRGGBB) [| wordmark]", the icon's name as on
         simpleicons.org; wordmark: the icon is the app's name, so it isn't written beside it. Apps not listed (or
         offline) get the logo cut out of their banner, never shown larger than it is. -->
    <string-array name="top_shelf_logos" translatable="false">
        <item>com.google.android.youtube.tv | youtube | FF0000</item>
        <item>com.netflix.ninja | netflix | E50914</item>
        <item>com.apple.atve.androidtv.appletv | appletv | FFFFFF | wordmark</item>
        <item>com.stremio.one | stremio | 7B5BF5</item>
        <item>com.google.android.youtube.tvmusic | youtubemusic | FF0000</item>
        <item>com.plexapp.android | plex | EBAF00</item>
        <item>com.wbd.stream | hbomax | FFFFFF | wordmark</item>
        <item>com.formulaone.production | f1 | E10600 | wordmark</item>
        <item>com.android.vending | googleplay | 414141</item>
    </string-array>

    <!-- What the top shelf's button opens for a feed's title (Up from the dock, then OK): "package | link", with
         {id} (its IMDb id), {type} (movie or series) and {title} (its name). A link with {title} but no {id} can
         only search for the title, and the button says so ("Search in Netflix"). Use a link the app declares in
         its manifest (adb shell dumpsys package <package>): one it has no activity for only opens the app, and the
         button then says "Open Netflix". Titles an app publishes itself open with the app's own link. Without a
         line here, the button opens the app. -->
    <string-array name="top_shelf_links" translatable="false">
        <item>com.stremio.one | stremio:///detail/{type}/{id}</item>
        <!-- Netflix's TV app takes https://www.netflix.com only for /title and /watch, which need Netflix's own ids. -->
        <item>com.netflix.ninja | nflx://www.netflix.com/search?q={title}</item>
        <item>com.apple.atve.androidtv.appletv | https://tv.apple.com/search?term={title}</item>
    </string-array>
</resources>
