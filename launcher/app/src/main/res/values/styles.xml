<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TvHome" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Top bar (layout/top_bar.xml), in three looks picked by config.xml's top_bar_style. Each look is a
         theme overlay that sets the bar's and its buttons' styles. -->
    <style name="ThemeOverlay.TopBar.Pills" parent="">
        <item name="topBarStyle">@style/TopBar</item>
        <item name="topButtonStyle">@style/TopButton</item>
    </style>

    <style name="ThemeOverlay.TopBar.Apple" parent="">
        <item name="topBarStyle">@style/TopBar</item>
        <item name="topButtonStyle">@style/TopButton.Apple</item>
    </style>

    <style name="ThemeOverlay.TopBar.Google" parent="">
        <item name="topBarStyle">@style/TopBar.Google</item>
        <item name="topButtonStyle">@style/TopButton.Google</item>
    </style>

    <style name="TopBar">
        <item name="android:orientation">horizontal</item>
    </style>

    <!-- Google TV: the icon buttons share one translucent tray, as on the stock launcher. -->
    <style name="TopBar.Google">
        <item name="android:background">@drawable/gtv_tray</item>
        <item name="android:padding">6dp</item>
        <item name="android:divider">@drawable/gtv_tray_gap</item>
        <item name="android:showDividers">middle</item>
        <!-- The focused button grows past its slot and lifts onto a shadow. -->
        <item name="android:clipChildren">false</item>
        <item name="android:clipToPadding">false</item>
    </style>

    <!-- Frosted pill with icon and label, tvOS style (the original look). The paddings apply to the open pill;
         the label's style is in layout/top_bar_button.xml. -->
    <style name="TopButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="topBarMode">pill</item>
    </style>

    <!-- Apple TV: a frosted circle with the icon that opens into the labelled pill when focused. -->
    <style name="TopButton.Apple">
        <item name="topBarMode">expand</item>
    </style>

    <!-- Google TV: a faint circle in the tray that turns pale and grows a little when focused, with its
         name shown under the bar. Sizes measured on the stock launcher. -->
    <style name="TopButton.Google">
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:background">@drawable/gtv_button_bg</item>
        <item name="topBarMode">caption</item>
        <item name="topBarIconSize">18dp</item>
        <item name="topBarIconTint">@drawable/gtv_icon</item>
    </style>
</resources>
