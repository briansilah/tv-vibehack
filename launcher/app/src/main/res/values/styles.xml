<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TvHome" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Text in Outfit (a variable font) at one weight: use style="@style/Outfit.Medium" instead of fontFamily plus
         fontVariationSettings on the view. A view with its own android:fontVariationSettings builds a new typeface
         as it inflates, about 10 ms per view on a TCL Google TV (docs/performance.md). On Android 9+ values-v28 loads
         each weight once, from res/font-v28, and every view shares it. Android 8 can't set a weight in font XML,
         so there these styles set it per view as before. -->
    <style name="Outfit.ExtraLight" parent="">
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:fontVariationSettings">"'wght' 200"</item>
    </style>

    <style name="Outfit.Light" parent="">
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:fontVariationSettings">"'wght' 300"</item>
    </style>

    <style name="Outfit.Regular" parent="">
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:fontVariationSettings">"'wght' 400"</item>
    </style>

    <style name="Outfit.Medium" parent="">
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:fontVariationSettings">"'wght' 500"</item>
    </style>

    <style name="Outfit.Bold" parent="">
        <item name="android:fontFamily">@font/outfit</item>
        <item name="android:fontVariationSettings">"'wght' 700"</item>
    </style>

    <!-- Top bar (layout/top_bar.xml), in four looks picked by config.xml's top_bar_style. Each look is a
         theme overlay that sets the bar's and its buttons' styles. The bar sits in the top right corner
         (ProfileCorner) and comes out when focus moves up there. -->
    <style name="ThemeOverlay.TopBar.Tvos" parent="">
        <item name="topBarStyle">@style/TopBar</item>
        <item name="topButtonStyle">@style/TopButton.Tvos</item>
    </style>

    <style name="ThemeOverlay.TopBar.Pills" parent="">
        <item name="topBarStyle">@style/TopBar</item>
        <item name="topButtonStyle">@style/TopButton</item>
    </style>

    <style name="ThemeOverlay.TopBar.Apple" parent="">
        <item name="topBarStyle">@style/TopBar</item>
        <item name="topButtonStyle">@style/TopButton.Apple</item>
    </style>

    <style name="ThemeOverlay.TopBar.Google" parent="">
        <item name="topBarStyle">@style/TopBar.Google</item>
        <item name="topButtonStyle">@style/TopButton.Google</item>
    </style>

    <style name="TopBar">
        <item name="android:orientation">horizontal</item>
    </style>

    <!-- Google TV: the icon buttons share one translucent tray, as on the stock launcher. -->
    <style name="TopBar.Google">
        <item name="android:background">@drawable/gtv_tray</item>
        <item name="android:padding">6dp</item>
        <item name="android:divider">@drawable/gtv_tray_gap</item>
        <item name="android:showDividers">middle</item>
        <!-- The focused button grows past its slot and lifts onto a shadow. -->
        <item name="android:clipChildren">false</item>
        <item name="android:clipToPadding">false</item>
    </style>

    <!-- Frosted pill with icon and label, tvOS style (the original look). The paddings apply to the open pill;
         the label's style is in layout/top_bar_button.xml. -->
    <style name="TopButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="topBarMode">pill</item>
    </style>

    <!-- Apple TV: a frosted circle with the icon that opens into the labelled pill when focused. -->
    <style name="TopButton.Apple">
        <item name="topBarMode">expand</item>
    </style>

    <!-- Google TV: a faint circle in the tray that turns pale and grows a little when focused, with its
         name shown under the bar. Sizes measured on the stock launcher. -->
    <style name="TopButton.Google">
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:background">@drawable/gtv_button_bg</item>
        <item name="topBarMode">caption</item>
        <item name="topBarIconSize">18dp</item>
        <item name="topBarIconTint">@drawable/gtv_icon</item>
    </style>

    <!-- Apple TV (tvOS 26), the tabs of Control Center's header: a grey glyph, in a white circle when focused.
         Measured on tvOS at 1080p: 60 px circles side by side, glyphs about 28 px. -->
    <style name="TopButton.Tvos">
        <item name="android:layout_height">30dp</item>
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:background">@drawable/tab_bg</item>
        <item name="topBarMode">tab</item>
        <item name="topBarIconSize">16dp</item>
        <item name="topBarIconTint">@drawable/tab_icon</item>
    </style>
</resources>
