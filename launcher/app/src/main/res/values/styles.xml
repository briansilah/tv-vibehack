<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TvHome" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Type. Every piece of text takes one of these styles (style="@style/Text.Body") and sets only its colour,
         never its own font, size or spacing. The scale follows tvOS's text styles (Apple's Human Interface
         Guidelines) at half their point size: tvOS sizes are pixels on a 1080p screen, and the TV draws 2 px per
         sp. As on tvOS, text is Medium, which reads at a distance where light weights break up; only the small
         capitalised labels are Semibold.

         The typeface is Inter (SIL Open Font License, launcher/FONT-LICENSE-OFL.txt), the open typeface closest to
         Apple's SF Pro. Its three fonts in res/font are named for their role: text_medium and text_semibold, in
         the optical size for small text, and display_medium, finer and tighter, for titles and clocks (Title 3
         and up). tools/fonts.py builds them, and can rebuild them in another typeface in one step. Each is a
         small static font: it needs no variation instance, so every view with a style shares the one typeface
         Android loads for it (a view with its own android:fontVariationSettings cost 10 ms to inflate,
         docs/performance.md). -->
    <style name="Text" parent="">
        <item name="android:fontFamily">@font/text_medium</item>
        <item name="android:textSize">14.5sp</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- The top shelf: the focused dock app's name, larger than any tvOS style. -->
    <style name="Text.LargeTitle">
        <item name="android:fontFamily">@font/display_medium</item>
        <item name="android:textSize">44sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- tvOS Title 1, 76 pt: a screen's title (arranging apps). -->
    <style name="Text.Title1">
        <item name="android:fontFamily">@font/display_medium</item>
        <item name="android:textSize">38sp</item>
    </style>

    <!-- tvOS Title 3, 48 pt. -->
    <style name="Text.Title3">
        <item name="android:fontFamily">@font/display_medium</item>
        <item name="android:textSize">24sp</item>
    </style>

    <!-- tvOS Headline, 38 pt: menu rows. -->
    <style name="Text.Headline">
        <item name="android:textSize">19sp</item>
    </style>

    <!-- tvOS Callout, 31 pt: buttons and list rows. -->
    <style name="Text.Callout">
        <item name="android:textSize">15.5sp</item>
    </style>

    <!-- tvOS Body, 29 pt: tile names. -->
    <style name="Text.Body" />

    <!-- tvOS Caption 1, 25 pt. -->
    <style name="Text.Caption1">
        <item name="android:textSize">12.5sp</item>
    </style>

    <!-- tvOS Caption 2, 23 pt. -->
    <style name="Text.Caption2">
        <item name="android:textSize">11.5sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- A small capitalised label over a title: the greeting, "Home screen". -->
    <style name="Text.Overline">
        <item name="android:fontFamily">@font/text_semibold</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- A remote key's name on a key cap: OK. -->
    <style name="Text.KeyCap">
        <item name="android:fontFamily">@font/text_semibold</item>
        <item name="android:textSize">11.5sp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- The large clock on Home. Proportional figures, as tvOS's clocks: tabular ones leave gaps around a 1. Inter
         raises the colon between digits to the middle of the figures, as SF Pro does in times. -->
    <style name="Text.Clock">
        <item name="android:fontFamily">@font/display_medium</item>
        <item name="android:textSize">48sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- AM or PM after a clock. -->
    <style name="Text.Clock.Period">
        <item name="android:fontFamily">@font/text_semibold</item>
        <item name="android:textSize">14.5sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- The date next to a clock. -->
    <style name="Text.Clock.Date">
        <item name="android:fontFamily">@font/text_medium</item>
        <item name="android:textSize">14.5sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- A compact time in the top bar, as on tvOS (tvOS Headline). Tabular figures, so it keeps its width as it
         changes and whatever sits beside it stays put. -->
    <style name="Text.Time" parent="Text.Headline">
        <item name="android:fontFeatureSettings">"tnum"</item>
    </style>

    <!-- The Clock screensaver (ClockDream). -->
    <style name="Text.Clock.Screensaver">
        <item name="android:textSize">120sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="Text.Clock.Screensaver.Period">
        <item name="android:fontFamily">@font/text_semibold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Text.Clock.Screensaver.Date">
        <item name="android:fontFamily">@font/text_medium</item>
        <item name="android:textSize">18sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Top bar (layout/top_bar.xml), in three looks picked by config.xml's top_bar_style. Each look is a
         theme overlay that sets the bar's and its buttons' styles. -->
    <style name="ThemeOverlay.TopBar.Pills" parent="">
        <item name="topBarStyle">@style/TopBar</item>
        <item name="topButtonStyle">@style/TopButton</item>
    </style>

    <style name="ThemeOverlay.TopBar.Apple" parent="">
        <item name="topBarStyle">@style/TopBar</item>
        <item name="topButtonStyle">@style/TopButton.Apple</item>
    </style>

    <style name="ThemeOverlay.TopBar.Google" parent="">
        <item name="topBarStyle">@style/TopBar.Google</item>
        <item name="topButtonStyle">@style/TopButton.Google</item>
    </style>

    <style name="TopBar">
        <item name="android:orientation">horizontal</item>
    </style>

    <!-- Google TV: the icon buttons share one translucent tray, as on the stock launcher. -->
    <style name="TopBar.Google">
        <item name="android:background">@drawable/gtv_tray</item>
        <item name="android:padding">6dp</item>
        <item name="android:divider">@drawable/gtv_tray_gap</item>
        <item name="android:showDividers">middle</item>
        <!-- The focused button grows past its slot and lifts onto a shadow. -->
        <item name="android:clipChildren">false</item>
        <item name="android:clipToPadding">false</item>
    </style>

    <!-- Frosted pill with icon and label, tvOS style (the original look). The paddings apply to the open pill;
         the label's style is in layout/top_bar_button.xml. -->
    <style name="TopButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="topBarMode">pill</item>
    </style>

    <!-- Apple TV: a frosted circle with the icon that opens into the labelled pill when focused. -->
    <style name="TopButton.Apple">
        <item name="topBarMode">expand</item>
    </style>

    <!-- Google TV: a faint circle in the tray that turns pale and grows a little when focused, with its
         name shown under the bar. Sizes measured on the stock launcher. -->
    <style name="TopButton.Google">
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:background">@drawable/gtv_button_bg</item>
        <item name="topBarMode">caption</item>
        <item name="topBarIconSize">18dp</item>
        <item name="topBarIconTint">@drawable/gtv_icon</item>
    </style>
</resources>
