<?xml version="1.0" encoding="utf-8"?>
<!-- Apple TV top bar tab glyph: dark on the focused tab's white circle, grey (60 % white) otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="#FF2C2C2E" />
    <item android:color="#99FFFFFF" />
</selector>
