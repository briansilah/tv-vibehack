<?xml version="1.0" encoding="utf-8"?>
<!-- Home Settings (SettingsActivity), laid out as tvOS's Settings: the page's title at the top, a preview of the top
     shelf on the left (what Home shows behind the dock), the list on the right. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B0B0C">

    <TextView
        android:id="@+id/settingsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="44dp"
        android:textColor="#FFFFFFFF"
        style="@style/Text.Title3"
        android:includeFontPadding="false"
        android:singleLine="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="100dp">

        <LinearLayout
            android:layout_width="432dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <com.gathin.tvhome.ShelfPreview
                android:id="@+id/settingsPreview"
                android:layout_width="432dp"
                android:layout_height="243dp"
                android:elevation="18dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/settingsAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:gravity="center_horizontal"
                android:textColor="#A6FFFFFF"
                style="@style/Text.Callout"
                android:lineSpacingMultiplier="1.15" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/settingsScroll"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="40dp"
            android:clipToPadding="false"
            android:paddingTop="12dp"
            android:paddingBottom="64dp"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/settingsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
