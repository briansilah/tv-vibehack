<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Ambient glow in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Top shelf: the focused dock app's name, positioned above the dock in code. Full width, so changing
         the name redraws it without laying out the screen again. -->
    <TextView
        android:id="@+id/heroName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="68dp"
        android:alpha="0"
        android:textColor="#FFFFFFFF"
        android:textSize="48sp"
        style="@style/Outfit.Light"
        android:letterSpacing="-0.02"
        android:includeFontPadding="false"
        android:singleLine="true" />

    <!-- 32dp side padding: the grid below widens by another 24dp so the full-width dock panel and the
         scaled edge tiles fit; the tiles keep their 56dp inset. Children may draw past the padding: the top
         right corner's buttons come out from under the profile picture, a little beyond its capsule. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="26dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Top right, as on Apple TV: the time and the profile picture in a capsule whose right edge lines up with
             the dock panel's (DockDecoration: 16dp past the tiles), as on tvOS. Moving up there opens it like
             Control Center's header, with the top bar's buttons. -->
        <FrameLayout
            android:id="@+id/topRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:clipChildren="false">

            <com.gathin.tvhome.ProfileCorner
                android:id="@+id/corner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:clipChildren="false">

                <!-- No format: TextClock then uses the locale's own, "8:52 PM" or "20:52" with the TV's 24-hour
                     setting. -->
                <TextClock
                    android:id="@+id/time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#B8FFFFFF"
                    android:textSize="13sp"
                    style="@style/Outfit.Medium"
                    android:includeFontPadding="false"
                    android:singleLine="true" />

                <!-- Inflated in MainActivity with the look chosen in config.xml (top_bar_style). -->
                <ViewStub
                    android:id="@+id/topBarStub"
                    android:inflatedId="@+id/topButtons"
                    android:layout="@layout/top_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <FrameLayout
                    android:id="@+id/avatar"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/avatar_bg"
                    android:focusable="true"
                    android:clickable="true"
                    android:contentDescription="@string/profile"
                    android:nextFocusLeft="@+id/btnSettings"
                    android:nextFocusDown="@+id/grid">

                    <ImageView
                        android:id="@+id/avatarImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/avatar_silhouette"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/avatarInitials"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:visibility="gone"
                        android:textColor="#FFFFFFFF"
                        android:textSize="11sp"
                        style="@style/Outfit.Medium"
                        android:includeFontPadding="false"
                        android:importantForAccessibility="no" />
                </FrameLayout>
            </com.gathin.tvhome.ProfileCorner>
        </FrameLayout>

        <!-- The wrapper clips at the grid's edge; the grid itself must not clip so scaled tiles can overflow their cells. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>

    <!-- Google TV-style top bar: the focused button's name, under the bar (positioned in code). -->
    <TextView
        android:id="@+id/topCaption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0"
        android:maxWidth="240dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:importantForAccessibility="no"
        android:textColor="#FFE4F3FF"
        android:textSize="13sp"
        style="@style/Outfit.Medium"
        android:letterSpacing="0.01" />
</FrameLayout>
