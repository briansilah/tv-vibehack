<?xml version="1.0" encoding="utf-8"?>
<!-- An app's actions (OK held on it), full screen as on Google TV: the app on the left, its actions on the right. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B0B0C">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="96dp"
        android:paddingEnd="96dp">

        <LinearLayout
            android:id="@+id/sheetApp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <FrameLayout
                android:id="@+id/sheetCard"
                android:layout_width="288dp"
                android:layout_height="162dp"
                android:background="@drawable/tile_bg"
                android:elevation="18dp">

                <ImageView
                    android:id="@+id/sheetBanner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@null" />

                <ImageView
                    android:id="@+id/sheetIcon"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/sheetName"
                android:layout_width="288dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#FFFFFFFF"
                android:textSize="24sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 400" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sheetActions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="24dp" />
    </LinearLayout>
</FrameLayout>
