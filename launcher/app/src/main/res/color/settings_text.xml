<?xml version="1.0" encoding="utf-8"?>
<!-- A Home Settings row's text and icons: dark on the focused row's white, else white. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="#FF111111" />
    <item android:color="#FFFFFFFF" />
</selector>
